async function loadBooks() { // async - метка асинхроности (допускает что ответ может прийти не сразу)
function - это как метод в Java (просто помечает не как обьек а как фунцию для обьекта )
    const response = await fetch('/api/books');
    // const - аля тип переменой (неизменяймая переменая)
   response - имя переменой (можно любое?)
   await - ключивое слово нейкий контрак для асинхронности типо погоди ответ будет прото пинг
   fetch('/api/books') - fetch тоже метод который ображается к методу REST который помечан как GET
    const books = await response.json();
    // первые 2 слово анологично
    а дальше подожи пока метод .json() примит и расшифрует response
    console.log(books); - выведи всё на экран (что то вроде sout)
}